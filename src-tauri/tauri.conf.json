{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCRCPY Studio",
  "version": "0.1.3",
  "identifier": "com.techydruid.scrcpystudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SCRCPY Studio",
        "width": 1080,
        "height": 740,
        "minWidth": 920,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "category": "Utility",
    "shortDescription": "Smart Android mirroring and control powered by scrcpy",
    "longDescription": "SCRCPY Studio is a desktop frontend for scrcpy with phone mirroring, direct camera streaming, evidence-based Android Desktop Mode, wireless setup, recording and capture tools, and compatibility fallbacks. macOS uses Homebrew-installed scrcpy and Android Platform Tools."
  }
}

