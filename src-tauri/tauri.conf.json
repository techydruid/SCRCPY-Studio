{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCRCPY Studio",
  "version": "0.1.0",
  "identifier": "com.techydruid.scrcpystudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SCRCPY Studio",
        "width": 1120,
        "height": 620,
        "minWidth": 860,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Smart Android mirroring and control powered by scrcpy",
    "longDescription": "SCRCPY Studio is a smart scrcpy frontend with auto-tuned profiles, creator mode, wireless setup, self-healing launch fallbacks, and plain-language connection diagnostics."
  }
}

